{
	"name": "@aithos/client-identity",
	"version": "0.0.0-dev",
	"private": true,
	"type": "module",
	"license": "Apache-2.0",
	"exports": {
		".": "./src/index.ts",
		"./sqlite": "./src/sqlite.ts",
		"./client": "./src/client.ts"
	},
	"scripts": {
		"test": "bun test tests/signatures.test.ts tests/identity.test.ts tests/http.test.ts",
		"test:integration": "bun test tests/harness.test.ts",
		"typecheck": "tsc --noEmit",
		"typecheck:integration": "tsc --noEmit -p tsconfig.integration.json",
		"prepare:harness": "node scripts/prepare-harness.mjs",
		"test:dev": "bun run scripts/live-dev.ts",
		"build:lambda": "bun build --target=node --format=esm src/lambda.ts --outfile=dist/lambda.mjs",
		"demo": "bun run examples/demo.ts",
		"format": "biome format --write .",
		"format:check": "biome format ."
	},
	"dependencies": {
		"structured-headers": "2.0.2",
		"zod": "4.4.3",
		"@aws-sdk/client-dynamodb": "3.1138.0",
		"@aws-sdk/lib-dynamodb": "3.1138.0",
		"@aws-sdk/client-secrets-manager": "3.1138.0"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"typescript": "6.0.3",
		"@biomejs/biome": "2.4.8",
		"@types/aws-lambda": "8.10.163"
	}
}
