{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["bun"],
		"lib": ["ES2022", "DOM", "DOM.Iterable"]
	},
	"include": ["src", "tests", "scripts/seed-dev.ts"],
	"exclude": ["tests/harness.test.ts"]
}
