diff --git a/tests/session/caller-session-store.test.ts b/tests/session/caller-session-store.test.ts
new file mode 100644
index 0000000..7453307
--- /dev/null
+++ b/tests/session/caller-session-store.test.ts
@@ -0,0 +1,94 @@
+import { afterEach, expect, test } from 'bun:test';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { type CallerAccess, CallerAccessDenied } from '../../src/contracts/caller-access.js';
+import type { AgentSession } from '../../src/contracts/session.js';
+import { CallerSessionStore } from '../../src/session/caller-session-store.js';
+import { InMemorySessionStore } from '../../src/session/session-store.js';
+import { SqliteSessionStore } from '../../src/storage/sqlite-stores.js';
+
+const directories: string[] = [];
+afterEach(() => {
+  for (const path of directories.splice(0)) rmSync(path, { recursive: true });
+});
+
+function access(identityId: string, merchantId = 'shop'): CallerAccess {
+  return {
+    current: () => ({ identityId, merchantId, kind: 'key' }),
+    allows: () => true,
+    canResume: () => true,
+    aroundSession: (_id, run) => run(),
+    denyAction: () => undefined,
+    aroundAction: (_capability, _id, run) => run(),
+  };
+}
+
+function session(id: string): AgentSession {
+  return {
+    agentSessionId: id,
+    agentId: 'seller',
+    merchantId: 'shop',
+    channel: 'a2a',
+    customerContext: {},
+    createdAt: new Date(),
+  };
+}
+
+test('owner is assigned at creation and cannot be supplied or replaced by the caller', () => {
+  const underlying = new InMemorySessionStore();
+  const alice = new CallerSessionStore(underlying, access('alice'));
+  const bob = new CallerSessionStore(underlying, access('bob'));
+  alice.createSession({ ...session('shared'), callerIdentityId: 'forged' });
+  expect(underlying.getSession('shared', 'shop')?.callerIdentityId).toBe('alice');
+  expect(() => bob.getSession('shared', 'shop')).toThrow(CallerAccessDenied);
+  expect(() => bob.createSession(session('shared'))).toThrow();
+  expect(() =>
+    bob.setCommerceContext('shared', { shopwareSalesChannelId: 'x', shopwareContextToken: 'x' }),
+  ).toThrow(CallerAccessDenied);
+  expect(alice.getPublicSession('shared', 'shop')).not.toHaveProperty('callerIdentityId');
+});
+
+test('legacy sessions and another merchant are denied, never adopted', () => {
+  const underlying = new InMemorySessionStore();
+  underlying.createSession(session('legacy'));
+  const alice = new CallerSessionStore(underlying, access('alice'));
+  expect(() => alice.getSession('legacy', 'shop')).toThrow(CallerAccessDenied);
+  expect(() => alice.getSession('legacy', 'other')).toThrow(CallerAccessDenied);
+  expect(underlying.getSession('legacy', 'shop')?.callerIdentityId).toBeUndefined();
+});
+
+test('SQLite retains owner on restart and context changes; expired records cannot be overwritten', () => {
+  const directory = mkdtempSync(join(tmpdir(), 'caller-store-test-'));
+  directories.push(directory);
+  const options = { databasePath: join(directory, 'sessions.sqlite') };
+  const underlying = new SqliteSessionStore(options);
+  const alice = new CallerSessionStore(underlying, access('alice'));
+  alice.createSession(session('persisted'));
+  alice.setCommerceContext('persisted', {
+    shopwareSalesChannelId: 's',
+    shopwareContextToken: 'server-secret',
+  });
+  const restarted = new SqliteSessionStore(options);
+  expect(restarted.getSession('persisted', 'shop')?.callerIdentityId).toBe('alice');
+  expect(() =>
+    new CallerSessionStore(restarted, access('bob')).getSession('persisted', 'shop'),
+  ).toThrow(CallerAccessDenied);
+  underlying.createSession({ ...session('expired'), expiresAt: new Date(1) });
+  expect(() => underlying.createSession(session('expired'))).toThrow();
+  expect(restarted.getPublicSession('persisted', 'shop')).not.toHaveProperty('commerceContext');
+});
+
+test('audit failure refuses creation before the session exists', () => {
+  const underlying = new InMemorySessionStore();
+  const controller: CallerAccess = {
+    ...access('alice'),
+    aroundSession: () => {
+      throw new Error('audit full');
+    },
+  };
+  expect(() =>
+    new CallerSessionStore(underlying, controller).createSession(session('absent')),
+  ).toThrow('audit full');
+  expect(underlying.getSession('absent', 'shop')).toBeUndefined();
+});
