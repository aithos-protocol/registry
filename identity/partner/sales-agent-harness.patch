diff --git a/src/session/caller-session-store.ts b/src/session/caller-session-store.ts
new file mode 100644
index 0000000..48dac8b
--- /dev/null
+++ b/src/session/caller-session-store.ts
@@ -0,0 +1,47 @@
+import { type CallerAccess, CallerAccessDenied } from '../contracts/caller-access.js';
+import type { AgentSession, CommerceContext } from '../contracts/session.js';
+import { type SessionStore, toPublicSession } from './session-store.js';
+
+/** The owner is persisted in the same record as the session, not attached later. */
+export class CallerSessionStore implements SessionStore {
+  constructor(
+    private readonly store: SessionStore,
+    private readonly access: CallerAccess,
+  ) {}
+
+  createSession(session: AgentSession): AgentSession {
+    const caller = this.access.current();
+    if (!caller || caller.merchantId !== session.merchantId) {
+      throw new CallerAccessDenied();
+    }
+    // Reserve a durable audit event before changing session state.
+    return this.access.aroundSession(session.agentSessionId, () =>
+      this.store.createSession({ ...session, callerIdentityId: caller.identityId }),
+    );
+  }
+
+  getSession(id: string, merchantId: string): AgentSession | undefined {
+    const caller = this.access.current();
+    if (!caller || caller.merchantId !== merchantId || !this.access.canResume(id)) {
+      throw new CallerAccessDenied();
+    }
+    const session = this.store.getSession(id, merchantId);
+    if (session && session.callerIdentityId !== caller.identityId) {
+      throw new CallerAccessDenied();
+    }
+    return session;
+  }
+
+  getPublicSession(id: string, merchantId: string) {
+    const session = this.getSession(id, merchantId);
+    return session ? toPublicSession(session) : undefined;
+  }
+
+  setCommerceContext(id: string, context: CommerceContext): AgentSession {
+    const caller = this.access.current();
+    if (!caller || !this.getSession(id, caller.merchantId)) {
+      throw new CallerAccessDenied();
+    }
+    return this.store.setCommerceContext(id, context);
+  }
+}
