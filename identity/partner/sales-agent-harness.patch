--- /dev/null
+++ b/src/contracts/caller-access.ts
@@ -0,0 +1,31 @@
+/** Optional server-owned admission boundary. Never populate it from request JSON. */
+export interface TrustedCaller {
+  readonly identityId: string;
+  readonly merchantId: string;
+  readonly kind: 'key' | 'provisional';
+}
+
+export interface CallerAccess {
+  current(): TrustedCaller | undefined;
+  allows(capability: string): boolean;
+  canResume(sessionId: string): boolean;
+  aroundSession<T>(sessionId: string, run: () => T): T;
+  denyAction(capability: string, sessionId: string): void;
+  aroundAction<T>(capability: string, sessionId: string, run: () => Promise<T>): Promise<T>;
+}
+
+export interface RequestAdmission {
+  readonly extensions: readonly {
+    readonly uri: string;
+    readonly description: string;
+    readonly required: boolean;
+    readonly params?: Record<string, string>;
+  }[];
+  run(request: Request, next: (request: Request) => Promise<Response>): Promise<Response>;
+}
+
+export class CallerAccessDenied extends Error {
+  constructor() {
+    super('Caller is not permitted to access this operation or session');
+  }
+}
